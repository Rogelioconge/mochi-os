+/* First drag MOVE: the stock handler sends the child ABORT and sets dragged=1,
+ * then returns without moving the viewport. Replaying that SAME event once after
+ * the stock handler has transitioned the state uses the stock delta/clamp path.
+ * This targets Albums only; no change to inertia, thresholds or velocity code.
+ * widget_dispatch calls the vtable's on_event directly (not this before-children
+ * hook), so the two calls cannot recurse through m1plus_scroll_event.
+ * WARNING: experimental until real AWTK / device validation. */
+__attribute__((noinline)) static int sc_first_move(void *w, void *e) {
+    if (!mox_first_move_candidate(B(w, SC_PRESSED), B(w, SC_DRAGGED), B(w, SC_SNAP), B(w, SC_XSLIDE),
+                                  B(w, SC_YSLIDE), I(w, SC_DOWN_X), I(w, SC_DOWN_Y), I(e, PE_X),
+                                  I(e, PE_Y), SC_DRAG_PX))
+        return RET_OK;
+    if (P(w, SC_WA) || sc_off()) return RET_OK;
+    widget_dispatch(w, e); /* native transition + abort of child press */
+    /* An abort handler may remove the page. Check registration before touching w again. */
+    if (mox_first_scroll_target == w && B(w, SC_PRESSED) && B(w, SC_DRAGGED) && !P(w, SC_WA))
+        widget_dispatch(w, e); /* native drag/update of the scroll offset */
+    return SC_RET_STOP; /* this MOVE was already fully dispatched */
+}
